---
import SiteLayout from "../layouts/SiteLayout.astro";
import { Hero } from "../components/home/Hero";
import { CreditLine } from "../../../demo/src/CreditLine";
import { SINTEL_CREDIT, SPRING_CREDIT, TRAIN_CREDIT } from "../../../demo/src/credits";
import { DEMO_META } from "../../../demo/src/demo-meta";
import { withBase } from "../lib/url";
import "../styles/home.css";

const demoHref = (slug: string, href?: string) => withBase(href ? `demos${href}` : `demos/#/${slug}`);
const docs = withBase("docs/start/introduction/");
---
<SiteLayout title="vidscroll: video that plays as you scroll" description="Scroll-scrubbed video for React and plain HTML. Smooth on any MP4 or WebM: videos with sparse keyframes are re-encoded in the browser automatically.">
  <main id="content" class="home">
    <Hero client:load src={withBase("commute.mp4")} docs={docs} demos="#demos" />

    <section class="home-section why" aria-labelledby="why-heading">
      <div class="home-section__intro">
        <h2 id="why-heading">Why vidscroll</h2>
        <p>
          Scroll-driven video usually means choppy scrubbing, or exporting hundreds of images by hand. vidscroll plays
          the video file you already have, smoothly, and keeps your content in step with it.
        </p>
      </div>
      <dl class="facts">
        <div>
          <dt>Smooth with any video</dt>
          <dd>Most exported videos are slow to scrub. vidscroll re-encodes them in the visitor's browser once and caches the result, or you prepare them ahead of time with <code>npx vidscroll encode</code>.</dd>
        </div>
        <div>
          <dt>No image sequences</dt>
          <dd>Use the MP4 or WebM you already have instead of exporting and loading a folder of frames. Image sequences still work when you need them.</dd>
        </div>
        <div>
          <dt>Content in sync</dt>
          <dd>Show text between two points, time captions to the footage, or drive any CSS from the scroll position, without writing scroll code.</dd>
        </div>
        <div>
          <dt>Loading handled</dt>
          <dd>A built-in loading screen with progress, a poster while the video loads, and clear console messages when a file is the problem.</dd>
        </div>
        <div>
          <dt>React and Next.js</dt>
          <dd>Components and hooks that work with server rendering. Give the video a <code>length</code> and it has its final height from the start, so nothing below it jumps.</dd>
        </div>
        <div>
          <dt>Or plain HTML</dt>
          <dd>A <code>&lt;vid-scroll&gt;</code> element for any other page, installed from npm or loaded with one script tag.</dd>
        </div>
      </dl>
      <a class="home-link" href={withBase("docs/start/how-it-works/")}>How it works</a>
    </section>

    <section class="home-section" id="demos" aria-labelledby="demos-heading">
      <div class="home-section__intro">
        <h2 id="demos-heading">Demos</h2>
        <p>Each one is built with the library and plain CSS.</p>
      </div>
      <ul class="gallery">
        {DEMO_META.map((demo) => (
          <li>
            <a class="demo-card" href={demoHref(demo.slug, demo.href)}>
              <span class="demo-card__poster">
                <img src={withBase(demo.poster)} alt="" loading="lazy" width="960" height="540" />
              </span>
              <span class="demo-card__title">{demo.title}</span>
              <span class="demo-card__text">{demo.description}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <footer class="home-footer">
      <p>Train animation: <CreditLine credit={TRAIN_CREDIT} /></p>
      <p>Mountain clip: <CreditLine credit={SPRING_CREDIT} /></p>
      <p>Snow clip: <CreditLine credit={SINTEL_CREDIT} /></p>
      <p>MIT licensed. <a href="https://github.com/nikhilswain/vidscroll">Source on GitHub</a>.</p>
    </footer>
  </main>
</SiteLayout>
