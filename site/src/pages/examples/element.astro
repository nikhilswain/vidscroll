---
import ExampleReporter from "../../components/ExampleReporter.astro";
import { EXAMPLES } from "../../examples";
import { withBase } from "../../lib/url";
import "../../styles/base.css";
import "../../styles/example.css";

const markup = EXAMPLES.element
  .source!.replace(/^<script[^>]*><\/script>\s*/, "")
  .replace(/src="\/([^"]+)"/g, (_, path) => `src="${withBase(path)}"`);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{EXAMPLES.element.title}</title>
  </head>
  <body>
    <Fragment set:html={markup} />
    <script>
      import "vidscroll/element";
    </script>
    <ExampleReporter />
  </body>
</html>
