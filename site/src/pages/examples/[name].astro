---
import ExampleRoot from "../../components/ExampleRoot";
import ExampleReporter from "../../components/ExampleReporter.astro";
import ElementScript from "../../components/ElementScript.astro";
import { EXAMPLES } from "../../examples";
import { withBase } from "../../lib/url";
import "../../styles/base.css";
import "../../styles/example.css";

export function getStaticPaths() {
  return Object.keys(EXAMPLES).map((name) => ({ params: { name } }));
}
const { name } = Astro.params;
const entry = EXAMPLES[name];
const markup =
  entry.lang === "html" && entry.source
    ? entry.source
        .replace(/^<script[^>]*src="https:\/\/cdn[^"]*"[^>]*><\/script>\s*/, "")
        .replace(/src="\/([^"]+)"/g, (_, path) => `src="${withBase(path)}"`)
    : null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{entry.title}</title>
    <link rel="icon" type="image/svg+xml" href={withBase("favicon.svg")} />
  </head>
  <body>
    {markup ? <Fragment set:html={markup} /> : <ExampleRoot client:only="react" name={name} />}
    {markup && <ElementScript />}
    <ExampleReporter />
  </body>
</html>
