---
import { NAV, docsHref } from "../lib/nav";
import { withBase } from "../lib/url";

interface Props {
  slug: string;
}
const { slug } = Astro.props;
---
<nav class="sidebar" id="sidebar" aria-label="Documentation" transition:persist="sidebar">
  <div class="sidebar__head">
    <span>Documentation</span>
    <button class="sidebar__close" type="button" aria-label="Close navigation" data-menu-close>
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M4 4l10 10M14 4L4 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
    </button>
  </div>
  {NAV.map((group) => (
    <details class="sidebar__group" open>
      <summary>{group.title}</summary>
      <ul>
        {group.items.map((item) => (
          <li>
            {item.slug ? (
              <a href={withBase(docsHref(item.slug))} aria-current={item.slug === slug ? "page" : undefined}>
                {item.title}
              </a>
            ) : (
              <span class="sidebar__planned" title="Not written yet">{item.title}</span>
            )}
          </li>
        ))}
      </ul>
    </details>
  ))}
</nav>
